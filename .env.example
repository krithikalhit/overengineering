# --- Auth ---
# Long random string. Used to sign the admin session cookie.
AUTH_SECRET=change-me-to-a-long-random-string
# Single shared password for the /admin dashboard.
ADMIN_PASSWORD=change-me

# --- Google Sheets ---
# Spreadsheet ID (the long ID in the sheet URL).
GOOGLE_SHEET_ID=
# Service account email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Service account private key. Paste the full PEM string;
# escape newlines as \n if storing in a single line (Vercel does this for you).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Runway (master financial sheet) ---
# Two modes. If GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET are set, /runway uses
# Google OAuth (each user signs in; sheet permissions gate access). If they are
# unset, /runway falls back to the CRM service account above — share the master
# sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor, and /runway is gated by
# the admin password instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the NextAuth session JWT. Run: openssl rand -base64 32
NEXTAUTH_SECRET=
# http://localhost:3000 locally; the prod URL on Vercel.
NEXTAUTH_URL=http://localhost:3000
# The master financial spreadsheet (long ID in the sheet URL). This is NOT the
# CRM sheet above — Runway reads/writes it with the signed-in user's account.
SPREADSHEET_ID=
# Optional: pin the main tab name. If unset, the app auto-detects the tab whose
# column A contains the category labels from lib/runway/sheetMap.ts.
RUNWAY_SHEET_TAB=

# --- Google Calendar (Meetings) ---
# Calendar ID. "primary" reads the calendar belonging to the service account
# (not what you want). Use the user's calendar ID (e.g. you@yourdomain.com)
# and share that calendar with the service account email as "See all event details".
GOOGLE_CALENDAR_ID=primary

# --- PostHog (Creators sign-up tracker, /creators) ---
# Personal API key with query:read (PostHog → Settings → Personal API keys).
POSTHOG_PERSONAL_API_KEY=
# Numeric project id (in the PostHog URL: /project/<id>/...).
POSTHOG_PROJECT_ID=
# Only if not on US cloud.
POSTHOG_HOST=https://us.posthog.com

# --- Instagram (Creators tracker auto-fill) ---
# Instagram shows nothing to anonymous requests. Paste the `sessionid` cookie from a browser
# where you're logged in (DevTools → Application → Cookies → instagram.com → sessionid).
# The app then reads reel captions, thumbnails, handles and follower counts. Rotates when
# you log out; refresh it if reels stop auto-filling.
INSTAGRAM_SESSION_ID=
